{
  "name": "gymbro",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite web",
    "build": "tsc -p web && vite build web && node tools/check-bundle.mjs dist && node tools/check-styles.mjs web/src",
    "preview": "vite preview web",
    "typecheck": "tsc -p web --noEmit",
    "test": "vitest run --root web",
    "test:private": "GYMBRO_PRIVATE=1 vitest run --root web",
    "check:private": "node tools/check-private.mjs --all",
    "build:preview": "vite build web --mode preview"
  },
  "dependencies": {
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "dexie": "^4.4.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "fake-indexeddb": "^6.2.8",
    "typescript": "5.7",
    "vite": "^6.4.6",
    "vitest": "^2.1.9"
  }
}
